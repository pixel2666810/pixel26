{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pixel26",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "e5e23209-168c-4baf-af0f-c7f6d4a505b5","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f00c03d88a164c379a3fb732aad3efe3" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
